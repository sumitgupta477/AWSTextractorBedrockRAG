{
  "Comment": "RAG ingestion pipeline: async Textract OCR -> chunking Lambda -> Bedrock Knowledge Base sync -> wait until indexed -> invalidate the answer cache",
  "StartAt": "StartTextract",
  "States": {
    "StartTextract": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:textract:startDocumentTextDetection",
      "Parameters": {
        "DocumentLocation": {
          "S3Object": {
            "Bucket.$": "$.bucket",
            "Name.$": "$.key"
          }
        }
      },
      "ResultSelector": {
        "JobId.$": "$.JobId"
      },
      "ResultPath": "$.textractJob",
      "Retry": [
        {
          "ErrorEquals": ["Textract.ThrottlingException", "Textract.ProvisionedThroughputExceededException", "Textract.InternalServerErrorException"],
          "IntervalSeconds": 5,
          "MaxAttempts": 5,
          "BackoffRate": 2
        }
      ],
      "Next": "WaitForTextractCompletion"
    },
    "WaitForTextractCompletion": {
      "Type": "Wait",
      "Seconds": 10,
      "Next": "CheckTextractStatus"
    },
    "CheckTextractStatus": {
      "Comment": "Only the job status is kept so large Textract responses never exceed the 256 KB state payload limit.",
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:textract:getDocumentTextDetection",
      "Parameters": {
        "JobId.$": "$.textractJob.JobId",
        "MaxResults": 1
      },
      "ResultSelector": {
        "JobStatus.$": "$.JobStatus"
      },
      "ResultPath": "$.textractStatus",
      "Retry": [
        {
          "ErrorEquals": ["Textract.ThrottlingException", "Textract.ProvisionedThroughputExceededException"],
          "IntervalSeconds": 5,
          "MaxAttempts": 5,
          "BackoffRate": 2
        }
      ],
      "Next": "IsTextractComplete"
    },
    "IsTextractComplete": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.textractStatus.JobStatus",
          "StringEquals": "SUCCEEDED",
          "Next": "Chunking"
        },
        {
          "Variable": "$.textractStatus.JobStatus",
          "StringEquals": "PARTIAL_SUCCESS",
          "Next": "Chunking"
        },
        {
          "Variable": "$.textractStatus.JobStatus",
          "StringEquals": "FAILED",
          "Next": "FailPipeline"
        }
      ],
      "Default": "WaitForTextractCompletion"
    },
    "Chunking": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${chunking_function_arn}",
        "Payload": {
          "job_id.$": "$.textractJob.JobId",
          "source_bucket.$": "$.bucket",
          "source_key.$": "$.key"
        }
      },
      "ResultSelector": {
        "chunks_created.$": "$.Payload.chunks_created",
        "output_prefix.$": "$.Payload.output_prefix"
      },
      "ResultPath": "$.chunkingResult",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.TooManyRequestsException", "Lambda.SdkClientException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "SyncKnowledgeBase"
    },
    "SyncKnowledgeBase": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:bedrockagent:startIngestionJob",
      "Parameters": {
        "KnowledgeBaseId": "${knowledge_base_id}",
        "DataSourceId": "${data_source_id}",
        "Description": "Triggered by the RAG ingestion pipeline"
      },
      "ResultSelector": {
        "IngestionJobId.$": "$.IngestionJob.IngestionJobId"
      },
      "ResultPath": "$.syncResult",
      "Retry": [
        {
          "Comment": "Only one ingestion job can run per data source; wait and retry if another upload is already syncing.",
          "ErrorEquals": ["BedrockAgent.ConflictException", "BedrockAgent.ThrottlingException"],
          "IntervalSeconds": 30,
          "MaxAttempts": 10,
          "BackoffRate": 1.5
        }
      ],
      "Next": "WaitForIndexing"
    },
    "WaitForIndexing": {
      "Type": "Wait",
      "Seconds": 15,
      "Next": "CheckIndexingStatus"
    },
    "CheckIndexingStatus": {
      "Comment": "Poll the ingestion job so the execution only succeeds once the document is actually searchable.",
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:bedrockagent:getIngestionJob",
      "Parameters": {
        "KnowledgeBaseId": "${knowledge_base_id}",
        "DataSourceId": "${data_source_id}",
        "IngestionJobId.$": "$.syncResult.IngestionJobId"
      },
      "ResultSelector": {
        "IngestionJobId.$": "$.IngestionJob.IngestionJobId",
        "Status.$": "$.IngestionJob.Status",
        "Statistics.$": "$.IngestionJob.Statistics"
      },
      "ResultPath": "$.syncResult",
      "Retry": [
        {
          "ErrorEquals": ["BedrockAgent.ThrottlingException", "BedrockAgent.InternalServerException"],
          "IntervalSeconds": 5,
          "MaxAttempts": 5,
          "BackoffRate": 2
        }
      ],
      "Next": "IsIndexingComplete"
    },
    "IsIndexingComplete": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.syncResult.Status",
          "StringEquals": "COMPLETE",
          "Next": "InvalidateAnswerCache"
        },
        {
          "Or": [
            { "Variable": "$.syncResult.Status", "StringEquals": "FAILED" },
            { "Variable": "$.syncResult.Status", "StringEquals": "STOPPED" }
          ],
          "Next": "FailIndexing"
        }
      ],
      "Default": "WaitForIndexing"
    },
    "InvalidateAnswerCache": {
      "Comment": "Bump the knowledge-base version so the query Lambda stops serving answers cached before this document was indexed.",
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${cache_table_name}",
        "Key": {
          "cache_key": { "S": "#kb_version" }
        },
        "UpdateExpression": "ADD #v :one",
        "ExpressionAttributeNames": { "#v": "version" },
        "ExpressionAttributeValues": { ":one": { "N": "1" } }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 2,
          "MaxAttempts": 5,
          "BackoffRate": 2
        }
      ],
      "Next": "IngestionSucceeded"
    },
    "IngestionSucceeded": {
      "Type": "Succeed"
    },
    "FailIndexing": {
      "Type": "Fail",
      "Error": "KnowledgeBaseIngestionFailed",
      "Cause": "Bedrock Knowledge Base ingestion job failed or was stopped; check the job's failure reasons in the Bedrock console"
    },
    "FailPipeline": {
      "Type": "Fail",
      "Error": "TextractFailed",
      "Cause": "Textract text detection job failed"
    }
  }
}
